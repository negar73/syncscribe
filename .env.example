# ── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (postgres:16-alpine with user/pass/db below).
DATABASE_URL="postgresql://syncscribe:syncscribe@localhost:5432/syncscribe"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the JWT session cookie AND WebSocket upgrade tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# ── WebSocket collaboration server ─────────────────────────────────────────
# URL the browser uses to reach the y-websocket server (NEXT_PUBLIC vars are
# inlined into the client bundle at build time).
NEXT_PUBLIC_WS_URL="ws://localhost:1234"
# Port the standalone ws server binds to (server/ws-server.ts, `npm run ws`).
WS_PORT="1234"
